__Задание 3__


![alt_text](images/image4.png "image_tooltip")



```
docker-compose-elastic_kibana.yml
version: '3.9'

services:

  nginx:
    image: nginx:alpine
    container_name: nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./html:/usr/share/nginx/html:ro
      - ./conf.d:/etc/nginx/conf.d:ro
      - ./certs:/etc/nginx/certs:ro
    depends_on:
      - logstash
 
  elasticsearch:
    image: elasticsearch:8.12.2
    container_name: elasticsearch
    environment:
      - cluster.name=my_cluster
      - xpack.security.enabled=false
      - discovery.type=single-node
    ports:
      - 9200:9200
   
    healthcheck:
      test: ["CMD-SHELL", "curl -s http://localhost:9200 >/dev/null || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10

  kibana:
    image: kibana:8.12.2
    ports:
      - "5601:5601"
    depends_on:
      - elasticsearch
    environment:
      - ELASTICSEARCH_HOSTS=http://elasticsearch:9200
   
  logstash:
    image: logstash:8.12.2
    container_name: logstash
    environment:
      ES_HOST: "elasticsearch:9200"
    ports:
      - "5044:5044/udp"
    volumes:
      - ./configs/logstash/config.yml:/usr/share/logstash/config/logstash.yml
      - ./configs/logstash/pipelines.yml:/usr/share/logstash/config/pipelines.yml
      - ./configs/logstash/pipelines:/usr/share/logstash/config/pipelines
    depends_on:
      - elasticsearch

gen_service_logs.conf
input {
    udp {
        port => 5140
        type => "nginx"
    }
}
filter {
    grok {
        match => { "message" => "%{SYSLOGTIMESTAMP:syslog_timestamp} %{DATA:syslog_program}: %{GREEDYDATA:json_payload}" }
    }
    json {
        source => "json_payload"
        remove_field => ["message", "json_payload"]
  }
}
output {
    stdout {}
    elasticsearch {
        hosts => [ "${ES_HOST}" ]
        index => "nginx-logs%-%{+YYYY.MM.dd}"
    }
}

default.conf #Для nginx
log_format json_logs escape=json '{'
    '"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"uri":"$request_uri",'
    '"status":$status,'
    '"body_bytes_sent":$body_bytes_sent,'
    '"request_time":$request_time,'
    '"user_agent":"$http_user_agent"'
'}';

server {
    listen 80;
    server_name localhost;

    # Отправка логов напрямую в контейнер logstash на порт 5140
    access_log syslog:server=logstash:5140,facility=local7,tag=nginx,severity=info json_logs;
    error_log syslog:server=logstash:5140,facility=local7,tag=nginx_err,severity=error;

    location / {
        root /usr/share/nginx/html;
        index index.html;
    }
}

